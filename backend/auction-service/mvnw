# Maven start up script for un*x

# Fallback to current user's home directory if mvn user is not set.
if [ -z "$MAVEN_USER_HOME" ]; then
  USER_HOME_DIR=$(getent passwd "${MAVEN_USER_NAME:-$(id -u -n)}" | cut -d: -f6)
  [ -z "$USER_HOME_DIR" ] && USER_HOME_DIR="$HOME"
  export MAVEN_USER_HOME="$USER_HOME_DIR/.m2"
fi

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD=maximum

warn() {
  echo "$*" >&2
}

die() {
  echo "$*" >&2
  exit 1
}

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false

case "$(uname)" in
CYGWIN*)
  cygwin=true
  ;;
Darwin*)
  darwin=true
  ;;
MSYS* | MINGW*)
  msys=true
  ;;
NONSTOP*)
  nonstop=true
  ;;
esac

# Classpath construction
CLASSPATH="$MAVEN_USER_HOME/.m2/repository/org/apache/maven/wrapper/maven-wrapper/3.1.0/maven-wrapper-3.1.0.jar"

# End of extension

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ]; then
  if [ -x "$JAVA_HOME/jre/sh/java" ]; then
    # IBM's JDK on AIX uses strange locations for the executables
    JAVACMD=$JAVA_HOME/jre/sh/java
  else
    JAVACMD=$JAVA_HOME/bin/java
  fi
  if [ ! -x "$JAVACMD" ]; then
    die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME"
  fi
else
  JAVACMD=java
  command -v java >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH."
fi

# Increase the memory available to Maven
# MAVEN_OPTS="-Xmx256m"

# For Cygwin or MSYS issue warning to JAVA_HOME to convert to mixed mode, else fail
if { [ "$cygwin" = "true" ] || [ "$msys" = "true" ]; } && [ -n "$JAVA_HOME" ]; then
  JAVA_HOME=$(
    cd "$JAVA_HOME" 2>/dev/null
    pwd
  )
  if [ ! -x "$JAVA_HOME/bin/java" ]; then
    die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME"
  fi
fi

# transitive.
WRAPPER_JAR=$(cd "$(dirname "$0")" && pwd)/".mvn/wrapper/maven-wrapper.jar"
expr "$WRAPPER_JAR" : '\([^ ]*\)$' | grep -q " " && die "ERROR: WRAPPER_JAR ($WRAPPER_JAR) must not contain spaces."

# Start the Maven Wrapper
exec "$JAVACMD" \
  $MAVEN_OPTS \
  -Dclassworlds.conf="$MAVEN_USER_HOME"/.m2/wrapper/m2.conf \
  -Dmaven.home="$MAVEN_USER_HOME"/.m2/wrapper \
  -Dmaven.multiModuleProjectDirectory="$MAVEN_USER_HOME" \
  -jar "$WRAPPER_JAR" "$@"
